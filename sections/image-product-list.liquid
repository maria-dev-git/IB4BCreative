            "product_title",
            "price"
          ]
        },
        "feature-image": {
          "type": "image",
          "static": true,
          "settings": {
            "width": "fill",
            "width_mobile": "fill",
            "height": "fill",
            "image_ratio": "adapt"
          }
        }
      },
      "block_order": []
    }
  ]
}
{% endschema %}
