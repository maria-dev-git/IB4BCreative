{% comment %}
  Collection-backed hat product template. Product panels and variant data render once;
  the component switches options and gallery images locally without section requests.
  @example
  Assign product.find-your-hat to a hat and choose its collection in the theme editor.
{% endcomment %}
{% liquid
  assign hats = section.settings.collection | default: collections.hats
  assign initial_product = hats.products.first | default: product
  for hat in hats.products
    if hat.id == product.id
      assign initial_product = hat
      break
    endif
  endfor
  assign app_blocks = section.blocks | where: 'type', '@app'
  if app_blocks.size > 0
    # App blocks require the page's product context and must render only once.
    assign initial_product = product
  endif
%}
{% render 'contrast-override', color_scheme: section.settings.color_scheme, section_id: section.id %}
{% render 'add-to-cart-button-styles' %}
{% render 'text-block-styles' %}
<script src="{{ 'hat-product-builder.js' | asset_url }}" type="module"></script>
<div class="section-background color-custom-{{ section.id }}"></div>
<hat-product-builder class="section section--{{ section.settings.section_width | default: 'page-width' }} color-custom-{{ section.id }} hat-builder" style="--hat-globo-thumbnail-scale-mobile: {{ section.settings.globo_thumbnail_zoom_mobile | default: section.settings.globo_thumbnail_zoom | default: 200 | divided_by: 100.0 }}; --hat-globo-thumbnail-scale: {{ section.settings.globo_thumbnail_zoom | default: 200 | divided_by: 100.0 }}; --hat-padding-top: {{ section.settings.padding_top | default: 48 }}px; --hat-padding-bottom: {{ section.settings.padding_bottom | default: 48 }}px;" data-currency="{{ cart.currency.iso_code | default: shop.currency | escape }}" data-money-format="{{ shop.money_format | escape }}" data-total-price-message="{{ 'hat_finder.total_price_breakdown' | t: total: '[total]', base: '[base]', addon: '[addon]' | escape }}" data-add="{{ 'products.product.add_to_cart' | t | escape }}" data-sold="{{ 'products.product.sold_out' | t | escape }}">
  {% if section.settings.heading != blank %}<h1 class="{{ section.settings.type_preset | default: 'h1' }}{% if section.settings.type_preset == 'custom' %} custom-typography custom-font-size hat-custom-typography{% endif %}" style="{% render 'hat-typography-style', settings: section.settings %}">{{ section.settings.heading | escape }}</h1>{% endif %}
  {% if section.settings.show_product_choices %}
    {% for block in section.blocks %}
      {% if block.type == 'product_choices' %}
        {% render 'hat-product-choices', hats: hats, initial_product: initial_product, block: block %}
      {% endif %}
    {% endfor %}
  {% endif %}
  {% if app_blocks.size > 0 %}
    {% render 'hat-product-panel', hat: initial_product, initial_product: initial_product, section_id: section.id, detail_blocks: section.blocks %}
  {% elsif hats.products == blank %}
    {% render 'hat-product-panel', hat: product, initial_product: initial_product, section_id: section.id, detail_blocks: section.blocks %}
  {% else %}
    {% for hat in hats.products %}
      {% render 'hat-product-panel', hat: hat, initial_product: initial_product, section_id: section.id, detail_blocks: section.blocks %}
    {% endfor %}
  {% endif %}
  <p class="visually-hidden" role="status" data-selection-status></p>
</hat-product-builder>
{% stylesheet %}
  .hat-builder { --hat-globo-active-scale: var(--hat-globo-thumbnail-scale); padding-block: var(--hat-padding-top) var(--hat-padding-bottom); }
  .hat-builder [hidden] { display: none !important; }
  .hat-builder__panel { display: grid; gap: var(--gap-2xl); min-inline-size: 0; }
  .hat-builder__gallery, .hat-builder__details { min-inline-size: 0; }
  .hat-builder__image img { inline-size: 100%; block-size: auto; max-block-size: 75vh; object-fit: contain; }
  .hat-builder__thumbs { display: flex; gap: var(--gap-sm); overflow-x: auto; margin-block-start: var(--margin-md); scrollbar-width: none; }
  .hat-builder__thumbs::-webkit-scrollbar { display: none; }
  .hat-builder__thumb { flex: 0 0 72px; padding: var(--padding-xs); border: 1px solid var(--color-border); background: transparent; color: inherit; cursor: pointer; }
  .hat-builder__thumb[aria-pressed='true'] { border-color: var(--color-foreground); outline: 1px solid var(--color-foreground); }
  .hat-builder__thumb img { inline-size: 100%; block-size: auto; aspect-ratio: 1; object-fit: contain; }
  .hat-builder__details { overflow-wrap: anywhere; }
  .hat-builder__detail { min-inline-size: 0; text-align: var(--hat-block-alignment); }
  .hat-builder .gpo-app .gpo-label,
  .hat-builder .gpo-app .gpo-label .label-content { color: var(--color-foreground); }
  .hat-builder .gpo-app [data-hat-price-source] { display: none !important; }
  .hat-builder__total-price { margin-block: 0; color: var(--color-foreground); overflow-wrap: anywhere; }
  .hat-builder .gpo-app .image-swatches .gpo-tooltip { display: none !important; }
  .hat-builder .gpo-app .image-swatches .gpo-swatch__inner {
    position: relative;
    transform-origin: center;
    transition: transform var(--animation-speed) var(--animation-easing);
  }
  .hat-builder .gpo-app .image-swatches:has(input:focus-visible),
  .hat-builder .gpo-app .image-swatches.hat-builder__swatch-touch { z-index: 2; }
  .hat-builder .gpo-app .image-swatches:has(input:focus-visible) .gpo-swatch__inner,
  .hat-builder .gpo-app .image-swatches.hat-builder__swatch-touch .gpo-swatch__inner { transform: translate(var(--hat-globo-preview-x, 0px), var(--hat-globo-preview-y, 0px)) scale(var(--hat-globo-preview-scale, var(--hat-globo-active-scale))); }
  @media (hover: hover) and (pointer: fine) {
    .hat-builder .gpo-app .image-swatches:has(.gpo-swatch__inner:hover) { z-index: 2; }
    .hat-builder .gpo-app .image-swatches .gpo-swatch__inner:hover { transform: translate(var(--hat-globo-preview-x, 0px), var(--hat-globo-preview-y, 0px)) scale(var(--hat-globo-preview-scale, var(--hat-globo-active-scale))); }
    .hat-builder .gpo-app .image-swatches label:hover { outline: none!important; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hat-builder .gpo-app .image-swatches .gpo-swatch__inner { transition: none; }
  }
  .hat-builder__detail > img, .hat-builder__detail > a > img { max-inline-size: 100%; block-size: auto; }
  .hat-builder__accordion summary { min-block-size: 44px; padding-block: var(--padding-sm); cursor: pointer; }
  .hat-builder__options { display: grid; gap: var(--gap-lg); margin-block: var(--margin-lg); }
  .hat-builder__field { min-inline-size: 0; margin: 0; padding: 0; border: 0; }
  .hat-builder__field legend { margin-block-end: var(--margin-sm); padding: 0; }
  .hat-builder__option-list { display: flex; flex-wrap: wrap; gap: var(--gap-sm); }
  .hat-builder__option { position: relative; flex: 0 1 calc(var(--hat-option-image-width) + 24px); min-inline-size: 0; cursor: pointer; }
  .hat-builder__radio { position: absolute; inline-size: 1px; block-size: 1px; opacity: 0; }
  .hat-builder__option-card { display: grid; justify-items: center; gap: var(--gap-xs); min-block-size: 44px; block-size: 100%; padding: var(--padding-sm); border: 1px solid var(--color-border); border-radius: var(--style-border-radius-inputs); text-align: center; overflow-wrap: anywhere; }
  .hat-builder__option-card img { inline-size: var(--hat-option-image-width); max-inline-size: 100%; block-size: auto; aspect-ratio: 1; object-fit: contain; }
  .hat-builder__radio:checked + .hat-builder__option-card { border-color: var(--color-foreground); outline: 1px solid var(--color-foreground); }
  .hat-builder__radio:focus-visible + .hat-builder__option-card { outline: 2px solid var(--color-foreground); outline-offset: 3px; }
  .hat-builder select { inline-size: 100%; min-inline-size: 0; min-block-size: 44px; padding: var(--padding-sm); color: var(--color-input-text); background: var(--color-input-background); border: 1px solid var(--color-input-border); border-radius: var(--style-border-radius-inputs); }
  .hat-builder__details form { display: grid; gap: var(--gap-md); }
  @media screen and (min-width: 750px) { .hat-builder__panel { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }
  @media screen and (max-width: 749px) {
    .hat-builder { --hat-globo-active-scale: var(--hat-globo-thumbnail-scale-mobile); }
    .hat-builder .hat-custom-typography,
    .hat-builder .hat-custom-typography > * { font-size: var(--hat-font-size-mobile, var(--font-size)); }
  }
{% endstylesheet %}
