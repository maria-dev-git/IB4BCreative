{% comment %}
  Image with Text using the shared section layout and fixed Image/Group blocks.
  Mobile overlay shares a grid cell so long content can expand the image region.
  @example
  Add Image with text overlay, choose an image, and set the mobile text position.
{% endcomment %}
{% capture children %}
  {% content_for 'block', type: 'image', id: 'image' %}
  {% content_for 'block', type: 'group', id: 'group' %}
{% endcapture %}
{% liquid
  assign layout_class = ''
  if section.settings.mobile_text_overlay
    assign layout_class = 'image-text-overlay-active'
  endif
%}
<div
  class="image-text-mobile-layout{% if section.settings.mobile_text_overlay %} image-text-mobile-layout--overlay{% endif %}"
  style="--image-text-mobile-horizontal: {{ section.settings.mobile_text_horizontal }}; --image-text-mobile-vertical: {{ section.settings.mobile_text_vertical }}; --image-text-mobile-inset: {{ section.settings.mobile_text_inset }}px; --image-text-mobile-overlay-color: {{ section.settings.mobile_overlay_color }}; --image-text-mobile-overlay-opacity: {{ section.settings.mobile_overlay_opacity | divided_by: 100.0 }}; --image-text-mobile-text-color: {{ section.settings.mobile_text_color }};"
>
  {% render 'section', section: section, children: children, section_id: section.id, background_color: section.settings.background_color, class: layout_class %}
</div>

{% stylesheet %}
  @media screen and (max-width: 749px) {
    .image-text-mobile-layout .group-block-content {
      align-items: center;
      text-align: center;
    }

    .image-text-mobile-layout .text-block {
      align-items: center;
      text-align: center;
    }

    .image-text-mobile-layout .text-block > * {
      text-align: center;
    }

    .image-text-mobile-layout .group-block-content > :is(.button, .button-secondary, .button-unstyled) {
      align-self: center;
      margin-inline: auto;
    }

    .image-text-mobile-layout--overlay .text-block,
    .image-text-mobile-layout--overlay .text-block > * {
      color: var(--image-text-mobile-text-color);
    }

    .image-text-mobile-layout--overlay > .section:has(.section-content-wrapper > .image-block--mobile-fill) > .custom-section-content {
      grid-column: 1 / -1;
    }

    .image-text-mobile-layout--overlay > .section > .custom-section-content > .section-content-wrapper {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto;
      gap: 0;
      isolation: isolate;
    }

    .image-text-mobile-layout--overlay > .section > .custom-section-content > .section-content-wrapper > .image-block {
      position: relative;
      grid-area: 1 / 1;
      align-self: stretch;
      inline-size: 100%;
      max-inline-size: 100%;
      block-size: 100%;
      min-inline-size: 0;
      margin: 0;
    }

    .image-text-mobile-layout--overlay > .section > .custom-section-content > .section-content-wrapper > .image-block::after {
      content: '';
      position: absolute;
      inset: 0;
      background-color: var(--image-text-mobile-overlay-color);
      opacity: var(--image-text-mobile-overlay-opacity);
      pointer-events: none;
    }

    .image-text-mobile-layout--overlay > .section > .custom-section-content > .section-content-wrapper > .image-block > :is(.image-block__image, .placeholder-image) {
      inline-size: 100%;
      block-size: 100%;
      object-fit: cover;
    }

    .image-text-mobile-layout--overlay > .section > .custom-section-content > .section-content-wrapper > .group-block {
      grid-area: 1 / 1;
      align-self: var(--image-text-mobile-vertical);
      justify-self: var(--image-text-mobile-horizontal);
      z-index: 1;
      inline-size: fit-content;
      max-inline-size: calc(100% - var(--image-text-mobile-inset) * 2);
      min-inline-size: 0;
      block-size: auto;
      margin: var(--image-text-mobile-inset);
      overflow-wrap: anywhere;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:mobile_image_text.name",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": [
      "header"
    ]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "use_color_scheme",
      "label": "t:settings.use_color_scheme",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ section.settings.use_color_scheme }}"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "content_direction",
      "label": "t:settings.direction",
      "options": [
        {
          "value": "column",
          "label": "t:options.vertical"
        },
        {
          "value": "row",
          "label": "t:options.horizontal"
        }
      ],
      "default": "column"
    },
    {
      "type": "checkbox",
      "id": "vertical_on_mobile",
      "label": "t:settings.vertical_on_mobile",
      "default": true,
      "visible_if": "{{ section.settings.content_direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.direction_start"
        },
        {
          "value": "center",
          "label": "t:options.direction_center"
        },
        {
          "value": "flex-end",
          "label": "t:options.direction_end"
        },
        {
          "value": "space-between",
          "label": "t:options.space_between"
        }
      ],
      "default": "flex-start",
      "visible_if": "{{ section.settings.content_direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "t:settings.position",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.top"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.bottom"
        }
      ],
      "default": "center",
      "visible_if": "{{ section.settings.content_direction == 'row' }}"
    },
    {
      "type": "checkbox",
      "id": "align_baseline",
      "label": "t:settings.align_baseline",
      "default": false,
      "visible_if": "{{ section.settings.vertical_alignment == 'flex-end' }}"
    },
    {
      "type": "select",
      "id": "horizontal_alignment_flex_direction_column",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.direction_start"
        },
        {
          "value": "center",
          "label": "t:options.direction_center"
        },
        {
          "value": "flex-end",
          "label": "t:options.direction_end"
        }
      ],
      "default": "flex-start",
      "visible_if": "{{ section.settings.content_direction != 'row' }}"
    },
    {
      "type": "select",
      "id": "vertical_alignment_flex_direction_column",
      "label": "t:settings.position",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.top"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.bottom"
        },
        {
          "value": "space-between",
          "label": "t:options.space_between"
        }
      ],
      "default": "center",
      "visible_if": "{{ section.settings.content_direction == 'column' }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "t:content.size"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "t:settings.height",
      "options": [
        {
          "value": "",
          "label": "t:options.auto"
        },
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "large",
          "label": "t:options.large"
        },
        {
          "value": "full-screen",
          "label": "t:options.full_screen"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "section_height_custom",
      "label": "t:settings.custom_height",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 50,
      "unit": "%",
      "visible_if": "{{ section.settings.section_height == 'custom' }}"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "background_media",
      "label": "t:settings.background_media",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "image",
          "label": "t:options.image"
        },
        {
          "value": "video",
          "label": "t:options.video"
        }
      ],
      "default": "none"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ section.settings.use_color_scheme == false and section.settings.background_media == 'none' }}"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:settings.video",
      "visible_if": "{{ section.settings.background_media == 'video' }}"
    },
    {
      "type": "select",
      "id": "video_position",
      "label": "t:settings.video_position",
      "options": [
        {
          "value": "cover",
          "label": "t:options.cover"
        },
        {
          "value": "contain",
          "label": "t:options.contain"
        }
      ],
      "default": "cover",
      "visible_if": "{{ section.settings.background_media == 'video' }}"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:settings.image",
      "visible_if": "{{ section.settings.background_media == 'image' }}"
    },
    {
      "type": "select",
      "id": "background_image_position",
      "label": "t:settings.image_position",
      "options": [
        {
          "value": "cover",
          "label": "t:options.cover"
        },
        {
          "value": "fit",
          "label": "t:options.fit"
        }
      ],
      "default": "cover",
      "visible_if": "{{ section.settings.background_media == 'image' }}"
    },
    {
      "type": "checkbox",
      "id": "toggle_overlay",
      "label": "t:settings.background_overlay"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "t:settings.overlay_color",
      "alpha": true,
      "default": "#00000026",
      "visible_if": "{{ section.settings.toggle_overlay }}"
    },
    {
      "type": "select",
      "id": "overlay_style",
      "label": "t:settings.overlay_style",
      "options": [
        {
          "value": "solid",
          "label": "t:options.solid"
        },
        {
          "value": "gradient",
          "label": "t:options.gradient"
        }
      ],
      "default": "solid",
      "visible_if": "{{ section.settings.toggle_overlay }}"
    },
    {
      "type": "select",
      "id": "gradient_direction",
      "label": "t:settings.gradient_direction",
      "options": [
        {
          "value": "to top",
          "label": "t:options.up"
        },
        {
          "value": "to bottom",
          "label": "t:options.down"
        }
      ],
      "default": "to top",
      "visible_if": "{{ section.settings.toggle_overlay and section.settings.overlay_style == 'gradient' }}"
    },
    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ section.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ section.settings.border != 'none' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:settings.color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ section.settings.use_color_scheme == false and section.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:mobile_image_text.mobile_layout"
    },
    {
      "type": "checkbox",
      "id": "mobile_text_overlay",
      "label": "t:mobile_image_text.enable_overlay",
      "default": true
    },
    {
      "type": "select",
      "id": "mobile_text_horizontal",
      "label": "t:mobile_image_text.horizontal_position",
      "options": [
        {
          "value": "start",
          "label": "t:options.direction_start"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "end",
          "label": "t:options.direction_end"
        }
      ],
      "default": "center",
      "visible_if": "{{ section.settings.mobile_text_overlay }}"
    },
    {
      "type": "select",
      "id": "mobile_text_vertical",
      "label": "t:mobile_image_text.vertical_position",
      "options": [
        {
          "value": "start",
          "label": "t:options.top"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "end",
          "label": "t:options.bottom"
        }
      ],
      "default": "center",
      "visible_if": "{{ section.settings.mobile_text_overlay }}"
    },
    {
      "type": "range",
      "id": "mobile_text_inset",
      "label": "t:mobile_image_text.edge_spacing",
      "min": 0,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.mobile_text_overlay }}"
    },
    {
      "type": "color",
      "id": "mobile_overlay_color",
      "label": "t:mobile_image_text.overlay_color",
      "default": "#000000",
      "visible_if": "{{ section.settings.mobile_text_overlay }}"
    },
    {
      "type": "range",
      "id": "mobile_overlay_opacity",
      "label": "t:mobile_image_text.overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 40,
      "visible_if": "{{ section.settings.mobile_text_overlay }}"
    },
    {
      "type": "color",
      "id": "mobile_text_color",
      "label": "t:mobile_image_text.text_color",
      "default": "#FFFFFF",
      "visible_if": "{{ section.settings.mobile_text_overlay }}"
    }
  ],
  "presets": [
    {
      "name": "t:mobile_image_text.name",
      "category": "t:categories.storytelling",
      "settings": {
        "content_direction": "row",
        "gap": 32,
        "padding-block-start": 40,
        "padding-block-end": 40
      },
      "blocks": {
        "image": {
          "type": "image",
          "settings": {
            "image": "",
            "image_ratio": "square"
          },
          "static": true
        },
        "group": {
          "type": "group",
          "settings": {
            "horizontal_alignment_flex_direction_column": "flex-start",
            "width": "custom"
          },
          "blocks": {
            "heading": {
              "type": "text",
              "name": "t:names.heading",
              "settings": {
                "text": "t:html_defaults.signature_products",
                "type_preset": "h3"
              }
            },
            "text": {
              "type": "text",
              "settings": {
                "text": "t:html_defaults.made_with_care_extended",
                "max_width": "narrow"
              }
            },
            "button": {
              "type": "button",
              "settings": {
                "label": "t:text_defaults.shop_now_button_label",
                "link": "shopify://collections/all"
              }
            }
          },
          "block_order": [
            "heading",
            "text",
            "button"
          ],
          "static": true
        }
      }
    }
  ]
}
{% endschema %}
