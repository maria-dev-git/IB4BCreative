{%- comment -%}
  Renders border override CSS

  Rounded corners clip with `overflow: clip` to prevent creating a scroll container, which can cause issues with flexbox layout.
{%- endcomment -%}

{% liquid
  assign border_color = settings.border_color
  if settings.use_color_scheme and settings.color_scheme != blank
    assign border_color = settings.color_scheme.settings.border
  endif
%}
--border-width: {{ settings.border_width }}px; --border-style: {{ settings.border }}; --border-color:
{% if border_color != blank -%}
  rgb({{ border_color.rgba }})
{%- else -%}
  rgb(var(--color-border-rgb) / {{ settings.border_opacity | divided_by: 100.0 }})
{%- endif -%}
; --border-radius: {{ settings.border_radius }}px; {% if settings.border_radius > 0 %} overflow: clip; {% endif %}
